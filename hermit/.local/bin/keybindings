#!/usr/bin/env bash
# Search every Hyprland binding with rofi; selecting one copies the combination.

set -euo pipefail

pkill -x rofi && exit 0

rows() {
  hyprctl binds | awk '
    function flush() {
      if (key == "" && keycode != "" && keycode != "0") key = "code:" keycode
      if (key != "" && description != "") {
        combo = mods key
        printf "%-32s %s\n", combo, description
      }
      mods = ""; key = ""; keycode = ""; description = ""
    }
    /^bind/ { flush(); next }
    /modmask:/ {
      m = $2
      mods = ""
      if (int(m / 64) % 2) mods = mods "SUPER + "
      if (int(m / 4)  % 2) mods = mods "CTRL + "
      if (int(m / 8)  % 2) mods = mods "ALT + "
      if (int(m / 1)  % 2) mods = mods "SHIFT + "
      next
    }
    /key:/ && $1 == "key:" { $1 = ""; sub(/^ +/, ""); key = $0; next }
    /keycode:/ { keycode = $2; next }
    /description:/ { $1 = ""; sub(/^ +/, ""); description = $0; next }
    END { flush() }
  ' | sort -u
}

choice=$(rows | menu pick "Keybindings" -theme-str 'window { width: 720px; }') || exit 0
[[ -n $choice ]] || exit 0
printf '%s' "$choice" | sed -E 's/ {2,}.*$//' | wl-copy
