#!/usr/bin/env bash
# Pick an emoji with rofi, copy it, and type it into the focused window.
# The list is built from Python's Unicode database, so there is no data file.

set -euo pipefail

pkill -x rofi && exit 0

list() {
  python3 - <<'PY'
import unicodedata
ranges = [
    (0x1F300, 0x1F5FF), (0x1F600, 0x1F64F), (0x1F680, 0x1F6FF),
    (0x1F900, 0x1F9FF), (0x1FA70, 0x1FAFF), (0x2600, 0x26FF),
    (0x2700, 0x27BF), (0x1F1E6, 0x1F1FF),
]
for start, end in ranges:
    for code in range(start, end + 1):
        char = chr(code)
        try:
            name = unicodedata.name(char)
        except ValueError:
            continue
        print(f"{char}  {name.title()}")
PY
}

choice=$(list | menu pick "Emoji") || exit 0
[[ -n $choice ]] || exit 0
emoji=${choice%%  *}
printf '%s' "$emoji" | wl-copy
command -v wtype >/dev/null 2>&1 && wtype "$emoji" || true
