#!/usr/bin/env bash
# Install, launch, stop, inspect, or remove a Windows VM.
# Ported from omarchy-windows-vm, trimmed for a user in the docker group.
# Usage: windows-vm <install|launch [-k]|up|stop|toggle|status|state|remove|key|help>
#
# The VM is dockurr/windows (QEMU/KVM in a container). Disk lives in ~/.windows,
# ~/Windows is shared into the guest, config in ~/.config/windows. On install the
# OEM product key is read from firmware (windows-key) and, if found,
# injected via /oem/install.bat with slmgr after Windows finishes installing.

set -uo pipefail

CONFIG_DIR="$HOME/.config/windows"
COMPOSE_FILE="$CONFIG_DIR/docker-compose.yml"
CREDENTIALS_FILE="$CONFIG_DIR/credentials"
OEM_DIR="$CONFIG_DIR/oem"
STORAGE_DIR="$HOME/.windows"
SHARED_DIR="$HOME/Windows"
DESKTOP_FILE="$HOME/.local/share/applications/windows-vm.desktop"
IMAGE="dockurr/windows"
CONTAINER="windows"

# --- helpers -----------------------------------------------------------------

dc() {
  if docker compose version &>/dev/null; then
    docker compose -f "$COMPOSE_FILE" "$@"
  else
    docker-compose -f "$COMPOSE_FILE" "$@"
  fi
}

container_status() {
  docker inspect --format='{{.State.Status}}' "$CONTAINER" 2>/dev/null || true
}

need_pkgs() {
  local missing=()
  for pkg in "$@"; do
    pacman -Q "$pkg" &>/dev/null || missing+=("$pkg")
  done
  ((${#missing[@]} == 0)) || sudo pacman -S --needed --noconfirm "${missing[@]}"
}

valid_cores() { [[ $1 =~ ^[0-9]{1,2}$ ]] && ((10#$1 >= 1)); }
valid_username() { [[ $1 =~ ^[A-Za-z0-9_-]{1,20}$ ]]; }
valid_password() { [[ $1 =~ ^[[:print:]]{1,64}$ ]]; }

# Escape for a double-quoted YAML scalar inside compose (compose also
# interpolates $, so double it).
yaml_escape() {
  local v=$1
  v=${v//\\/\\\\}
  v=${v//\"/\\\"}
  v=${v//\$/\$\$}
  printf '%s' "$v"
}

read_credential() {
  local want="$1" key value
  [[ -f $CREDENTIALS_FILE ]] || return 1
  while IFS='=' read -r key value; do
    [[ $key == "$want" ]] && { printf '%s' "$value"; return 0; }
  done <"$CREDENTIALS_FILE"
  return 1
}

write_credentials() {
  (umask 077 && printf 'USERNAME=%s\nPASSWORD=%s\n' "$1" "$2" >"$CREDENTIALS_FILE")
}

available_storage_gb() {
  local path=$HOME
  [[ -d $STORAGE_DIR ]] && path=$STORAGE_DIR
  df -P -- "$path" | awk 'NR==2 {print int($4/1024/1024)}'
}

check_prerequisites() {
  local disk_gb=${1:-64} required=$(( ${1:-64} + 10 ))
  if [[ ! -e /dev/kvm ]]; then
    gum style --border normal --padding "1 2" --margin "1" \
      "❌ KVM virtualization not available!" "" \
      "Enable virtualization in BIOS or run:" \
      "  sudo modprobe kvm-intel  # Intel" \
      "  sudo modprobe kvm-amd    # AMD"
    exit 1
  fi
  if ! docker info &>/dev/null; then
    echo "❌ Cannot reach the Docker daemon. Try: sudo systemctl start docker" >&2
    exit 1
  fi
  local avail
  avail=$(available_storage_gb)
  if ((avail < required)); then
    echo "❌ Insufficient disk space! Available: ${avail}GB, required: ${required}GB (${disk_gb}GB disk + 10GB image)" >&2
    exit 1
  fi
}

# Write /oem/install.bat so the guest activates itself with the firmware key.
write_oem_key() {
  local key=$1
  mkdir -p "$OEM_DIR"
  printf '@echo off\r\ncscript //nologo %%windir%%\\system32\\slmgr.vbs /ipk %s\r\ncscript //nologo %%windir%%\\system32\\slmgr.vbs /ato\r\n' \
    "$key" >"$OEM_DIR/install.bat"
}

write_compose() {
  local ram="$1" cores="$2" disk="$3" username="$4" password="$5" tz="$6" version="$7"
  local esc_password
  esc_password=$(yaml_escape "$password")
  mkdir -p "$CONFIG_DIR" "$OEM_DIR"
  cat >"$COMPOSE_FILE" <<YAML
services:
  windows:
    image: $IMAGE
    container_name: $CONTAINER
    environment:
      VERSION: "$version"
      RAM_SIZE: "$ram"
      CPU_CORES: "$cores"
      DISK_SIZE: "$disk"
      USERNAME: "$username"
      PASSWORD: "$esc_password"
      PROTECT: "Y"
      TZ: "$tz"
      ARGUMENTS: "-rtc base=localtime,clock=host,driftfix=slew"
    devices:
      - /dev/kvm
      - /dev/net/tun
    cap_add:
      - NET_ADMIN
    ports:
      - 127.0.0.1:8006:8006
      - 127.0.0.1:3389:3389/tcp
      - 127.0.0.1:3389:3389/udp
    volumes:
      - $STORAGE_DIR:/storage
      - $SHARED_DIR:/shared
      - $OEM_DIR:/oem
    restart: "no"
    stop_grace_period: 2m
YAML
  chmod 0600 "$COMPOSE_FILE"
}

# --- commands ----------------------------------------------------------------

install_windows() {
  trap "echo ''; echo 'Installation cancelled by user'; exit 1" INT

  need_pkgs freerdp gum docker-compose openbsd-netcat
  check_prerequisites

  mkdir -p "$STORAGE_DIR" "$SHARED_DIR" "$HOME/.local/share/applications"
  chmod 0700 "$STORAGE_DIR" "$SHARED_DIR"

  cat >"$DESKTOP_FILE" <<DESKTOP
[Desktop Entry]
Name=Windows
Comment=Start Windows VM via Docker and connect with RDP
Exec=windows-vm launch
Icon=windows
Terminal=false
Type=Application
Categories=System;Virtualization;
DESKTOP

  local total_ram_gb total_cores
  total_ram_gb=$(awk 'NR==1 {printf "%d", $2/1024/1024}' /proc/meminfo)
  total_cores=$(nproc)
  echo ""
  echo "System Resources Detected:"
  echo "  Total RAM: ${total_ram_gb}G"
  echo "  Total CPU Cores: $total_cores"
  echo ""

  local ram_options=() size
  for size in 2 4 8 16 32 64; do ((size <= total_ram_gb)) && ram_options+=("${size}G"); done
  local selected_ram
  selected_ram=$(printf '%s\n' "${ram_options[@]}" | gum choose --selected="4G" --header="RAM for the Windows VM?")
  [[ -n $selected_ram ]] || { echo "Installation cancelled by user"; exit 1; }

  local selected_cores
  selected_cores=$(gum input --placeholder="1-$total_cores" --value="2" --header="CPU cores for the Windows VM?" --char-limit=2)
  [[ -n $selected_cores ]] || { echo "Installation cancelled by user"; exit 1; }
  if ! valid_cores "$selected_cores" || ((selected_cores > total_cores)); then
    echo "Invalid input. Using default: 2 cores"
    selected_cores=2
  fi

  local avail max_disk_gb
  avail=$(available_storage_gb)
  max_disk_gb=$((avail - 10))
  if ((max_disk_gb < 32)); then
    echo "❌ Insufficient disk space! Available: ${avail}GB, minimum: 42GB (32GB disk + 10GB image)" >&2
    exit 1
  fi
  local disk_options=()
  for size in 32 64 128 256 512; do ((size <= max_disk_gb)) && disk_options+=("${size}G"); done
  local default_disk="32G"
  ((max_disk_gb >= 64)) && default_disk="64G"
  local selected_disk
  selected_disk=$(printf '%s\n' "${disk_options[@]}" | gum choose --selected="$default_disk" --header="Disk size for the Windows VM? (64GB+ recommended)")
  [[ -n $selected_disk ]] || { echo "Installation cancelled by user"; exit 1; }
  check_prerequisites "${selected_disk%G}"

  local version
  version=$(printf '%s\n' "11 (Windows 11 Pro)" "11l (Windows 11 LTSC)" "11e (Windows 11 Enterprise)" "10 (Windows 10 Pro)" "10l (Windows 10 LTSC)" |
    gum choose --selected="11 (Windows 11 Pro)" --header="Windows edition?")
  [[ -n $version ]] || { echo "Installation cancelled by user"; exit 1; }
  version=${version%% *}

  local username password password_display
  username=$(gum input --placeholder="Username (Enter for default: docker)" --header="Windows username:")
  [[ -n $username ]] || username="docker"
  if ! valid_username "$username"; then
    echo "Invalid username (letters, digits, - or _, up to 20 chars). Using default: docker"
    username="docker"
  fi
  password=$(gum input --placeholder="Password (Enter for default: admin)" --password --header="Windows password:")
  if [[ -z $password ]]; then
    password="admin"; password_display="(default)"
  else
    password_display="(user-defined)"
  fi
  if ! valid_password "$password"; then
    echo "Invalid password (printable characters, up to 64). Using default: admin"
    password="admin"; password_display="(default)"
  fi

  # Firmware OEM key. An OEM key is tied to the edition the machine shipped with
  # (often Home); activation on Pro/LTSC will then fail, which is harmless.
  local key="" key_display="(none found)"
  echo ""
  echo "Looking for a Windows product key in firmware (may ask for sudo)..."
  if key=$(windows-key 2>/dev/null); then
    if gum confirm "Found firmware key ${key:0:5}-XXXXX-XXXXX-XXXXX-${key:24}. Use it to activate the VM?"; then
      key_display="${key:0:5}-XXXXX-XXXXX-XXXXX-${key:24}"
    else
      key=""; key_display="(skipped)"
    fi
  fi

  gum style --border normal --padding "1 2" --margin "1" --align left --bold \
    "Windows VM Configuration" "" \
    "Edition:   $version" \
    "RAM:       $selected_ram" \
    "CPU:       $selected_cores cores" \
    "Disk:      $selected_disk" \
    "Username:  $username" \
    "Password:  $password_display" \
    "Key:       $key_display"
  echo ""
  gum confirm "Proceed with this configuration?" || { echo "Installation cancelled by user"; exit 1; }

  local tz
  tz=$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)

  write_compose "$selected_ram" "$selected_cores" "$selected_disk" "$username" "$password" "$tz" "$version"
  write_credentials "$username" "$password"
  if [[ -n $key ]]; then
    write_oem_key "$key"
  else
    rm -f "$OEM_DIR/install.bat"
  fi

  echo ""
  echo "Starting Windows VM installation..."
  echo "This downloads a Windows image (may take 10-15 minutes)."
  echo "Monitor progress at: http://127.0.0.1:8006"
  echo ""
  if ! dc up -d; then
    echo "❌ Failed to start Windows VM!"
    echo "   - Docker daemon not running: sudo systemctl start docker"
    echo "   - Port already in use: is another VM running?"
    exit 1
  fi

  sleep 3
  xdg-open "http://127.0.0.1:8006" &>/dev/null &
  echo "Installation is running in the background."
  echo "Once finished, launch 'Windows' from the app launcher or: windows-vm launch"
  echo "To stop the VM: windows-vm stop"
}

remove_windows() {
  gum confirm --default=false "Remove Windows VM and delete all associated data?" || {
    echo "Removal cancelled by user"; exit 1
  }
  echo "Removing Windows VM..."
  [[ -f $COMPOSE_FILE ]] && dc down
  docker rm -f "$CONTAINER" &>/dev/null || true
  docker rmi "$IMAGE" &>/dev/null || true
  rm -f "$DESKTOP_FILE"
  rm -rf "$CONFIG_DIR" "$STORAGE_DIR"
  echo "Windows VM removal completed! ($SHARED_DIR was kept.)"
}

# Wait for QEMU to boot the guest, then for RDP to actually listen. During the
# first install nothing answers on 3389 for a long time, so bail out with a
# pointer to the web console instead of letting xfreerdp fail on a reset.
wait_until_ready() {
  local started_at count=0
  while true; do
    started_at=$(docker inspect --format='{{.State.StartedAt}}' "$CONTAINER" 2>/dev/null)
    if [[ -n $started_at ]] && docker logs --since "$started_at" "$CONTAINER" 2>&1 | grep -qi "windows started succes"; then
      break
    fi
    sleep 2
    ((++count > 60)) && { echo "Timeout: Windows VM did not boot within 2 minutes" >&2; return 1; }
  done
  count=0
  until nc -z 127.0.0.1 3389 2>/dev/null; do
    sleep 2
    if ((++count > 90)); then
      echo "Windows booted but RDP is not answering yet; setup is probably still running." >&2
      echo "Watch it at http://127.0.0.1:8006 and run 'windows-vm launch' again when it reaches the desktop." >&2
      xdg-open "http://127.0.0.1:8006" &>/dev/null &
      return 2
    fi
  done
}

launch_windows() {
  local keep_alive=false
  [[ ${1:-} == "--keep-alive" || ${1:-} == "-k" ]] && keep_alive=true

  if [[ ! -f $COMPOSE_FILE ]]; then
    echo "Windows VM not configured. Run: windows-vm install"
    exit 1
  fi

  local win_user win_pass
  win_user=$(read_credential USERNAME) || win_user="docker"
  win_pass=$(read_credential PASSWORD) || win_pass="admin"

  echo "Starting Windows VM..."
  if [[ $(container_status) != "running" ]]; then
    dc up -d || { echo "❌ Failed to start Windows VM! Check: windows-vm status"; exit 1; }
  fi
  wait_until_ready
  case $? in
  0) ;;
  2) exit 0 ;; # still installing; leave the VM running
  *)
    notify-send -u critical "Windows VM" "Failed to start Windows VM" 2>/dev/null
    exit 1
    ;;
  esac

  if $keep_alive; then
    echo "VM will keep running after RDP closes. To stop: windows-vm stop"
  else
    echo "VM will auto-stop when RDP closes."
  fi

  # FreeRDP 3 tries Kerberos before NTLM; the stock /etc/krb5.conf points at
  # MIT's sample realm and blocks ~23s offline. Use a realm-less config so it
  # falls straight through to NTLM against the local Windows account.
  local krb5_conf="$CONFIG_DIR/krb5.conf"
  if [[ ! -f $krb5_conf ]]; then
    printf '[libdefaults]\n  dns_lookup_kdc = false\n  dns_lookup_realm = false\n' >"$krb5_conf"
  fi
  export KRB5_CONFIG="$krb5_conf"

  local hypr_scale scale_percent rdp_scale=""
  hypr_scale=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .scale' 2>/dev/null)
  scale_percent=$(awk -v s="${hypr_scale:-1}" 'BEGIN {print int(s * 100)}')
  if ((scale_percent >= 170)); then
    rdp_scale="/scale:180"
  elif ((scale_percent >= 130)); then
    rdp_scale="/scale:140"
  fi

  xfreerdp3 /u:"$win_user" /p:"$win_pass" /v:127.0.0.1:3389 -grab-keyboard /sound /microphone /clipboard \
    /cert:ignore /title:"Windows VM" /dynamic-resolution /gfx:AVC444 \
    /floatbar:sticky:off,default:visible,show:fullscreen $rdp_scale

  if $keep_alive; then
    echo "RDP session closed. Windows VM is still running. To stop: windows-vm stop"
  else
    echo "RDP session closed. Stopping Windows VM..."
    dc down && echo "Windows VM stopped."
  fi
}

stop_windows() {
  [[ -f $COMPOSE_FILE ]] || { echo "Windows VM not configured."; exit 1; }
  echo "Stopping Windows VM..."
  dc down && echo "Windows VM stopped."
}

status_windows() {
  if [[ ! -f $COMPOSE_FILE ]]; then
    echo "Windows VM not configured. To set up: windows-vm install"
    exit 1
  fi
  local status
  status=$(container_status)
  if [[ -z $status ]]; then
    echo "Windows VM container not found. To start: windows-vm launch"
  elif [[ $status == "running" ]]; then
    echo "Windows VM: RUNNING"
    echo "  Web interface: http://127.0.0.1:8006"
    echo "  RDP:           127.0.0.1:3389"
    echo "  Connect:       windows-vm launch"
    echo "  Stop:          windows-vm stop"
  else
    echo "Windows VM is stopped (status: $status). To start: windows-vm launch"
  fi
}

# Machine-readable state for the bar widget: STATE<TAB>DETAIL, always exit 0.
#   unavailable  docker missing or VM not installed
#   off          container absent or exited
#   booting      container running, RDP not listening yet (boot or setup)
#   up           RDP answers on 3389
state_windows() {
  if ! command -v docker &>/dev/null || [[ ! -f $COMPOSE_FILE ]]; then
    printf 'unavailable\t%s\n' "not installed"
    return 0
  fi
  local status
  status=$(container_status)
  if [[ $status != "running" ]]; then
    printf 'off\t%s\n' "${status:-absent}"
  elif nc -z 127.0.0.1 3389 2>/dev/null; then
    printf 'up\t%s\n' "rdp"
  else
    printf 'booting\t%s\n' "no rdp"
  fi
}

# Start the VM in the background without opening RDP.
up_windows() {
  [[ -f $COMPOSE_FILE ]] || { echo "Windows VM not configured. Run: windows-vm install" >&2; exit 1; }
  [[ $(container_status) == "running" ]] && exit 0
  dc up -d
}

toggle_windows() {
  if [[ $(container_status) == "running" ]]; then stop_windows; else up_windows; fi
}

show_usage() {
  cat <<USAGE
Usage: windows-vm <command> [options]

Commands:
  install          Install and configure the Windows VM (uses the firmware OEM key if found)
  launch [-k]      Start the VM if needed and connect via RDP (-k / --keep-alive: don't stop on exit)
  up               Start the VM in the background, no RDP
  stop             Stop the running VM
  toggle           up if stopped, stop if running (what the bar widget calls)
  status           Show VM status
  state            One line for scripts: STATE<TAB>DETAIL (unavailable|off|booting|up)
  remove           Remove the VM and its disk (~/Windows shared folder is kept)
  key              Print the OEM Windows product key stored in firmware
  help             Show this help
USAGE
}

case "${1:-}" in
install) install_windows ;;
remove) remove_windows ;;
launch | start) launch_windows "${2:-}" ;;
up) up_windows ;;
stop | down) stop_windows ;;
toggle) toggle_windows ;;
status) status_windows ;;
state) state_windows ;;
key) exec windows-key ;;
help | --help | -h | "") show_usage ;;
*)
  echo "Unknown command: $1" >&2
  show_usage >&2
  exit 1
  ;;
esac
