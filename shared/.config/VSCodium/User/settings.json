{
  // Solitude is ported from solitude.nvim; scripts/vscodium.sh installs it
  "workbench.colorTheme": "Solitude",
  "workbench.startupEditor": "none",
  "security.workspace.trust.enabled": false,
  // Dispatch on keysyms so xkb remaps like caps:escape apply
  "keyboard.dispatch": "keyCode",
  // Hide everything but the editor and explorer; vim keys drive the rest
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "toggle",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.statusBar.visible": true,
  "workbench.editor.showTabs": "none",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.tips.enabled": false,
  "breadcrumbs.enabled": false,
  "chat.disableAIFeatures": true,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.stickyScroll.enabled": false,
  "editor.lightbulb.enabled": "off",
  "editor.codeLens": false,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "notebook.cellToolbarVisibility": "hover",
  "explorer.confirmDragAndDrop": false,
  "search.seedWithNearestWord": true,
  // blink.cmp's default preset accepts only with <C-y>
  "editor.acceptSuggestionOnEnter": "off",
  "editor.fontFamily": "'IosevkaTerm Nerd Font Mono', monospace",
  "editor.fontSize": 15,
  "editor.minimap.enabled": false,
  // Mirrors the Neovim options in nvim/lua/configs.lua
  "editor.lineNumbers": "relative",
  "editor.renderLineHighlight": "all",
  "editor.cursorSurroundingLines": 10,
  "editor.renderWhitespace": "trailing",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.guides.indentation": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.formatOnSave": true,
  "terminal.integrated.fontFamily": "'IosevkaTerm Nerd Font Mono'",
  // ty replaces Pylance, which is not allowed outside Microsoft builds
  "python.languageServer": "None",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "notebook.formatOnSave.enabled": true,
  "notebook.lineNumbers": "on",
  "notebook.output.scrolling": true,
  "jupyter.askForKernelRestart": false,
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  // dbt Power User needs dbt SQL files parsed as Jinja SQL
  "files.associations": {
    "*.sql": "jinja-sql",
    "*.yml": "jinja-yaml",
    "*.yaml": "jinja-yaml"
  },
  // Mirrors the keymaps in nvim/lua (configs.lua and plugins/)
  "vim.leader": "<space>",
  "vim.useSystemClipboard": false,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": false,
  "vim.incsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": false,
  "vim.highlightedyank.enable": true,
