  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#737373"
      }
    },
    {
      "scope": [
        "comment keyword.codetag",
        "keyword.other.todo"
      ],
      "settings": {
        "foreground": "#e49a44",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other",
        "meta.preprocessor",
        "entity.name.tag",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#c95757"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor.arrow"
      ],
      "settings": {
        "foreground": "#e49a44"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.sizeof"
      ],
      "settings": {
        "foreground": "#c95757"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "constant.character.escape",
        "string.regexp",
        "constant.character",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#c9c3ba"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#e49a44"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite",
        "meta.function-call.arguments"
      ],
      "settings": {
        "foreground": "#b4b4b4"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.parameter.function.language.special",
        "support.variable.magic",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#c4b6a6"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.module",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class.python"
      ],
      "settings": {
        "foreground": "#d5d5d5"
      }
    },
    {
      "scope": [
        "storage.type.function",
        "storage.type.class",
        "storage.type.function.python"
      ],
      "settings": {
        "foreground": "#c95757"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "punctuation.special",
        "punctuation.section.embedded",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#c4b6a6"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "meta.brace",
        "punctuation.section",
        "punctuation.parenthesis",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#737373"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.delimiter"
      ],
      "settings": {
        "foreground": "#c4b6a6"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e5e5e5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#c95757",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c4b6a6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#c4b6a6",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.list.unnumbered",
        "markup.list.numbered",
        "punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#737373"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#929d83"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#c95757"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e49a44"
      }
    },
    {
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#b4b4b4"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c95757"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#d5d5d5",
    "comment": "#737373",
    "decorator": "#c4b6a6",
    "enum": "#d5d5d5",
    "enumMember": "#e49a44",
    "event": "#c4b6a6",
    "function": "#e5e5e5",
    "interface": "#d5d5d5",
    "keyword": "#c95757",
    "macro": "#c95757",
    "method": "#e5e5e5",
    "modifier": "#c95757",
    "namespace": "#d5d5d5",
    "number": "#e49a44",
    "operator": "#e49a44",
    "parameter": "#b4b4b4",
    "property": "#e5e5e5",
    "regexp": "#c9c3ba",
    "string": "#c9c3ba",
    "struct": "#d5d5d5",
    "type": "#d5d5d5",
    "typeParameter": "#d5d5d5",
    "variable": "#b4b4b4",
    "selfParameter": "#c4b6a6",
    "variable.readonly": "#b4b4b4",
    "*.deprecated": {
      "strikethrough": true
    },
    "builtinConstant": "#e49a44",
    "variable.defaultLibrary": "#b4b4b4"
  }
}