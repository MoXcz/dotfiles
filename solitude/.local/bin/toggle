#!/usr/bin/env bash
# Start or stop a user service that changes how the session behaves.
# Usage: toggle <idle|nightlight>
#
#   idle        hypridle.service   (idle locking)
#   nightlight  hyprsunset.service (warm display)

set -euo pipefail

FLAG="${1:-}"
[[ -n $FLAG ]] || { echo "Usage: toggle <idle|nightlight>" >&2; exit 1; }

notify() { notify-send -a shell -u low "$1"; }

service_toggle() {
  local unit=$1 label=$2
  if systemctl --user is-active --quiet "$unit"; then
    systemctl --user stop "$unit"
    notify "$label off"
  else
    systemctl --user start "$unit"
    notify "$label on"
  fi
}

case "$FLAG" in
  idle) service_toggle hypridle.service "Idle locking" ;;
  nightlight) service_toggle hyprsunset.service "Nightlight" ;;
  *) echo "Unknown toggle: $FLAG" >&2; exit 1 ;;
esac
