#!/usr/bin/env bash
# Point the GTK/xdg-desktop-portal settings at the dark theme.
#
# settings.ini covers apps that read it at startup, but portals and anything
# using GSettings (file choosers, some dialogs) read dconf instead, and dconf
# is not a file this repo can stow. This is run once per session from
# autostart; it is idempotent.

set -euo pipefail

command -v gsettings >/dev/null 2>&1 || exit 0

gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita'
gsettings set org.gnome.desktop.interface icon-theme 'Adwaita'
gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita'
gsettings set org.gnome.desktop.interface font-name 'Adwaita Sans 11'
gsettings set org.gnome.desktop.interface document-font-name 'Adwaita Sans 11'
gsettings set org.gnome.desktop.interface monospace-font-name 'Iosevka Nerd Font 11'

# nemo is a Cinnamon app and reads the Cinnamon schema, not the GNOME one.
if gsettings list-schemas | grep -qx org.cinnamon.desktop.interface; then
  gsettings set org.cinnamon.desktop.interface gtk-theme 'Adwaita'
  gsettings set org.cinnamon.desktop.interface icon-theme 'Adwaita'
  gsettings set org.cinnamon.desktop.interface font-name 'Adwaita Sans 11'
fi

# Cinnamon's portal, which nemo asks for the color scheme.
if gsettings list-schemas | grep -qx org.x.apps.portal; then
  gsettings set org.x.apps.portal color-scheme 'prefer-dark'
fi
